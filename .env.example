# 1. Supabase Cloud Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Kira AI Assistant (OpenAI Compatible)
VITE_KIRAAI_BASE_URL=https://kiraai.vn/api/v1
VITE_KIRAAI_API_KEY=your-kira-api-key-here
VITE_KIRAAI_DEFAULT_MODEL=kira-mini-1.0
