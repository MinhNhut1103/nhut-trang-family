# =========================================================================
# VÍ DỤ CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# =========================================================================

# 1. Supabase Cloud Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Google AI Studio (Gemini Assistant)
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-google-ai-studio-api-key-here
VITE_GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
# VITE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
